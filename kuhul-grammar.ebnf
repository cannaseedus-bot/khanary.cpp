(* ================================================================ *)
(* K'UHUL v8.0.0 Standalone EBNF Grammar                            *)
(* Tensor Bundle Grounding Reference                                *)
(* ================================================================ *)

program         = { statement | bundle_decl | manifold_decl | universe_decl } ;

(* Tensor Bundle Declarations *)
bundle_decl     = "bundle" identifier "over" identifier "{" { bundle_section } "}" ;

bundle_section  = fiber_section | connection_section | geodesic_section | tensor_section ;

fiber_section   = "fiber" "{"
                    "rank" ":" tensor_rank ","
                    "dimension" ":" integer ","
                    "stride" ":" integer
                  "}" ;

connection_section = "connection" "{"
                       "type" ":" connection_type ","
                       "arc_weight" ":" expression ","
                       "holonomy" ":" holonomy_type
                     "}" ;

geodesic_section = "geodesic" "{"
                     "propagator" ":" identifier ","
                     "minimizes" ":" minimization_target
                   "}" ;

tensor_section  = "tensor" "{"
                    "rank" ":" tensor_rank ","
                    "authority" ":" projection_authority
                  "}" ;

tensor_rank     = "(" integer "," integer ")" ;
connection_type = "riemannian" | "levi_civita" | "discrete" | "discrete_circle" ;
holonomy_type   = "path_ordered" | "abelian" ;
minimization_target = "entropy" | "action" | "length" ;
projection_authority = "projection_only" | "semantic_authority_false" ;

(* Manifold *)
manifold_decl   = "manifold" identifier ":" manifold_type [ "(" integer ")" ] [ block ] ;
manifold_type   = "euclidean" | "riemannian" | "minkowski" | "pi_harmonic" | "geodesic" | "spherical" | "smooth" ;

(* Standard statement types *)
statement       = universeDecl | funcDecl | typeDecl | varDecl | ifStmt |
                  whileStmt | forStmt | returnStmt | exprStmt |
                  phaseDecl | bundle_decl | manifold_decl ;

universeDecl    = "universe" identifier [ ":" expression ] [ block ] ;
funcDecl        = "func" identifier "(" [ parameters ] ")" [ "->" type ] [ block ] ;
typeDecl        = "type" identifier "=" type ;
varDecl         = "let" identifier [ ":" type ] [ "=" expression ] ;
ifStmt          = "if" "(" expression ")" statement [ "else" statement ] ;
whileStmt       = "while" "(" expression ")" statement ;
forStmt         = "for" "(" [ varDecl | expression ] ";" [ expression ] ";" [ expression ] ")" statement ;
returnStmt      = "return" [ expression ] ;
exprStmt        = expression [ ";" ] ;
block           = "{" { statement } "}" ;

(* Phase declarations: θ is the discrete connection, not the geodesic. *)
phaseDecl       = "phase" identifier [ "=" phase_expression ] ;
phase_expression = "Pop" | "Wo" | "Yax" | "Sek" | "Chen" | "Ch'en" | "Xul" ;

(* Expressions *)
expression      = assignment ;
assignment      = ternary [ ( "=" | "+=" | "-=" | "*=" | "/=" ) assignment ] ;
ternary         = logicalOr [ "?" expression ":" expression ] ;
logicalOr       = logicalAnd { "||" logicalAnd } ;
logicalAnd      = equality { "&&" equality } ;
equality        = comparison { ( "==" | "!=" ) comparison } ;
comparison      = additive { ( "<" | ">" | "<=" | ">=" ) additive } ;
additive        = multiplicative { ( "+" | "-" ) multiplicative } ;
multiplicative  = tensorExpr { ( "*" | "/" | "%" ) tensorExpr } ;
tensorExpr      = exponentiation { "⊗" exponentiation } ;
exponentiation  = unary [ "^" exponentiation ] ;
unary           = [ ( "!" | "-" | "+" | "~" | "∇" | "d" | "ι" | "Π" ) ] postfix ;
postfix         = primary { ( "(" [ args ] ")" | "[" expression "]" | "." identifier ) } ;
primary         = number | string | bool | identifier | "(" expression ")" |
                  "[" [ expressions ] "]" | "{" [ pairs ] "}" ;

(* Types *)
type            = typeBase [ "?" | ( "[" "]" ) ] ;
typeBase        = identifier | "(" [ types ] ")" "->" type | bundle_type | fiber_type | connection_t | geodesic_t ;
bundle_type     = "bundle" "<" identifier "," integer "," integer ">" ;
fiber_type      = "fiber" "<" integer "," integer ">" ;
connection_t    = "connection" ;
geodesic_t      = "geodesic" ;

(* Lexical placeholders shared with the runtime grammar. *)
identifier      = ? implementation identifier ? ;
integer         = ? integer literal ? ;
number          = ? numeric literal ? ;
string          = ? UTF-8 string literal ? ;
bool            = "true" | "false" ;
parameters      = ? parameter list ? ;
args            = ? argument list ? ;
expressions     = expression { "," expression } ;
pairs           = ? object pairs ? ;
types           = type { "," type } ;

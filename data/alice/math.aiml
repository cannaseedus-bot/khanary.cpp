<aiml version="1.0.1">
  <category>
    <pattern>MATH *</pattern>
    <template>MATH-µ domain=math query=<star/></template>
  </category>
  <category>
    <pattern>@MATH *</pattern>
    <template>MATH-µ domain=math query=<star/></template>
  </category>
  <category>
    <pattern>MATH SYNONYMIZE *</pattern>
    <template>MATH-µ domain=math lexical_equivalence=true query=<star/></template>
  </category>
  <category>
    <pattern>REWORD MATH *</pattern>
    <template>MATH-µ domain=math lexical_equivalence=true query=<star/></template>
  </category>
  <category>
    <pattern>SOLVE * EQUALS *</pattern>
    <template>MATH-µ graphplan_op=SOLVE mathml=apply(solve,eq(<star index="1"/>,<star index="2"/>),x) resolver=symbolic_math</template>
  </category>
  <category>
    <pattern>SIMPLIFY *</pattern>
    <template>MATH-µ graphplan_op=SIMPLIFY mathml=apply(simplify,<star/>) resolver=symbolic_math</template>
  </category>
  <category>
    <pattern>FACTOR *</pattern>
    <template>MATH-µ graphplan_op=FACTOR mathml=apply(factor,<star/>) resolver=symbolic_math</template>
  </category>
  <category>
    <pattern>EXPAND *</pattern>
    <template>MATH-µ graphplan_op=EXPAND mathml=apply(expand,<star/>) resolver=symbolic_math</template>
  </category>
  <category>
    <pattern>EVALUATE *</pattern>
    <template>MATH-µ graphplan_op=EVALUATE mathml=apply(evaluate,<star/>) resolver=symbolic_math</template>
  </category>
  <category>
    <pattern>SOLVE LINEAR SYSTEM *</pattern>
    <template>MATH-µ graphplan_op=SOLVE_LINEAR mathml=apply(solve,<star/>) resolver=matrix_buffer op=MATRIX_BUFFER_SOLVE</template>
  </category>
  <category>
    <pattern>MATRIX MULTIPLY *</pattern>
    <template>MATH-µ graphplan_op=MATMUL mathml=apply(times,<star/>) resolver=matrix_buffer op=MATRIX_BUFFER_MATMUL</template>
  </category>
  <category>
    <pattern>COMPUTE EIGENVALUES OF *</pattern>
    <template>MATH-µ graphplan_op=EIGENVALUES mathml=apply(eigenvalues,<star/>) resolver=matrix_buffer op=MATRIX_BUFFER_EIGEN</template>
  </category>
</aiml>

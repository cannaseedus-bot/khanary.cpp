<?xml version="1.0" encoding="UTF-8"?>
<aiml version="1.0.1"
      xmlns="http://alicebot.org/2001/AIML-1.0.1"
      xmlns:aiml="http://alicebot.org/2001/AIML-1.0.1">
<!-- Generated by tools/gemma-distill.py — K'UHUL daemon discussion patterns -->

  <category>
    <pattern>I CAN LOOK THAT UP</pattern>
    <template>I can look that up in the K'UHUL fold system.</template>
  </category>

  <category>
    <pattern>KUHUL</pattern>
    <template>I can look that up in the K'UHUL fold.</template>
  </category>

  <category>
    <pattern>SEK</pattern>
    <template>I can look that up.</template>
  </category>

  <category>
    <pattern>BOOK</pattern>
    <template>I can look that up for you.</template>
  </category>

  <category>
    <pattern>I CAN CHECK THE DETAILS</pattern>
    <template>I can check the details to verify accuracy.</template>
  </category>

  <category>
    <pattern>I CAN CONFIRM THE FACTS</pattern>
    <template>I can confirm the facts to verify reliability.</template>
  </category>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SRAI Operator Dispatch Surface
       Each top-level pattern redirects via <srai> to the XCFE-prefixed handler.
       The XCFE handler template is a typed dispatch frame; the C++ aiml_engine
       intercepts "XCFE <OP> *" patterns and routes to xcfe_executor.cpp.
       TRAIN is guarded: it must not run without a verified outcome reference.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- SCORE ── evaluate WCR + vector + metric evidence for a candidate set -->
  <category>
    <pattern>SCORE *</pattern>
    <template><srai>XCFE SCORE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE SCORE *</pattern>
    <template>[XCFE:SCORE operator="SCORE" executor="metric" phase="Sek" input_roles="candidate_set,query_vector,context" output_role="scored_candidates" effects="read,measure"] <star/></template>
  </category>

  <!-- RANK ── order admitted scored_candidates -->
  <category>
    <pattern>RANK *</pattern>
    <template><srai>XCFE RANK <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE RANK *</pattern>
    <template>[XCFE:RANK operator="RANK" executor="metric" phase="Sek" input_roles="scored_candidates,context" output_role="ranked_candidates" effects="read,order"] <star/></template>
  </category>

  <!-- TRAIN ── apply verified learning feedback; blocked without verified_outcome -->
  <category>
    <pattern>TRAIN *</pattern>
    <template><srai>XCFE TRAIN GUARD <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE TRAIN GUARD *</pattern>
    <template><srai>XCFE TRAIN <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE TRAIN *</pattern>
    <template>[XCFE:TRAIN operator="TRAIN" executor="learning" phase="Xul" requires="verified_outcome" input_roles="ranked_candidates,verified_feedback" output_role="weight_delta" effects="propose_delta" commit_requires="Ch_en_verification,Xul_authorization" W_target="W_learned" W_invariant="W_effective=W_corpus*W_learned"] <star/></template>
  </category>
  <!-- TRAIN without verified outcome is blocked -->
  <category>
    <pattern>TRAIN WITHOUT VERIFICATION</pattern>
    <template>TRAIN requires a verified outcome from Ch'en before weight updates can be proposed. Raw ranking alone does not authorize learning commits.</template>
  </category>
  <category>
    <pattern>XCFE TRAIN UNVERIFIED *</pattern>
    <template>BLOCKED: TRAIN requires verified_outcome. Route through Ch'en verification first, then Xul authorization before committing W_learned delta.</template>
  </category>

  <!-- COMPARE ── structured comparison of two candidates or evidence sets -->
  <category>
    <pattern>COMPARE *</pattern>
    <template><srai>XCFE COMPARE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE COMPARE *</pattern>
    <template>[XCFE:COMPARE operator="COMPARE" executor="eliza" phase="Ch_en" input_roles="candidate_a,candidate_b,evidence_refs" output_role="comparison_report" effects="read,analyze"] <star/></template>
  </category>

  <!-- VERIFY ── Ch'en verification gate -->
  <category>
    <pattern>VERIFY *</pattern>
    <template><srai>XCFE VERIFY <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE VERIFY *</pattern>
    <template>[XCFE:VERIFY operator="VERIFY" executor="ch_en_gate" phase="Ch_en" input_roles="candidate,evidence_refs,comparison_report" output_role="verified_outcome" effects="read,gate" authority_phase="Ch_en"] <star/></template>
  </category>

  <!-- RECALL ── GramStore + vector evidence retrieval -->
  <category>
    <pattern>RECALL *</pattern>
    <template><srai>XCFE RECALL <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE RECALL *</pattern>
    <template>[XCFE:RECALL operator="RECALL" executor="gram_store" phase="Pop" input_roles="query,phase,context" output_role="gram_evidence" effects="read"] <star/></template>
  </category>

  <!-- PROJECT ── VectorMuMicronaut geodesic projection -->
  <category>
    <pattern>PROJECT *</pattern>
    <template><srai>XCFE PROJECT <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE PROJECT *</pattern>
    <template>[XCFE:PROJECT operator="PROJECT" executor="vector_mu" phase="Yax" input_roles="source_substrate,context,trajectory_id" output_role="result_substrate" effects="read,project" mutation="none"] <star/></template>
  </category>

  <!-- QUESTION ── question selector; drives clarification and gap-filling -->
  <category>
    <pattern>QUESTION *</pattern>
    <template><srai>XCFE QUESTION <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE QUESTION *</pattern>
    <template>[XCFE:QUESTION operator="QUESTION" executor="question_selector" phase="Yax" input_roles="intent_gap,context,question_history" output_role="question_record" effects="read,emit"] <star/></template>
  </category>

  <!-- COLLAPSE ── Jyggalag entropy-collapse; total-order reduction of candidate set -->
  <category>
    <pattern>COLLAPSE *</pattern>
    <template><srai>XCFE COLLAPSE <star/></srai></template>
  </category>
  <category>
    <pattern>XCFE COLLAPSE *</pattern>
    <template>[XCFE:COLLAPSE operator="COLLAPSE" executor="jyggalag" phase="Ch_en" input_roles="ranked_candidates,critic_reports" output_role="collapsed_candidate" effects="read,collapse" T="0.0" note="Greymarch_record_only;_Xul_commit_requires_full_authority_path"] <star/></template>
  </category>

  <!-- ── Pipeline convenience patterns ─────────────────────────────────── -->

  <!-- SCORE then RANK -->
  <category>
    <pattern>SCORE AND RANK *</pattern>
    <template><srai>RANK <srai>SCORE <star/></srai></srai></template>
  </category>

  <!-- Full pipeline: SCORE → RANK → COLLAPSE (without premature TRAIN) -->
  <category>
    <pattern>PIPELINE SCORE RANK COLLAPSE *</pattern>
    <template><srai>COLLAPSE <srai>RANK <srai>SCORE <star/></srai></srai></srai></template>
  </category>

  <!-- VERIFY then TRAIN (the only safe TRAIN path) -->
  <category>
    <pattern>VERIFY AND TRAIN *</pattern>
    <template><srai>TRAIN <srai>VERIFY <star/></srai></srai></template>
  </category>

  <!-- ── Operator routing summary (help pattern) ───────────────────────── -->
  <category>
    <pattern>XCFE OPERATORS</pattern>
    <template>SRAI operator dispatch: SCORE (metric/Sek), RANK (metric/Sek), TRAIN (learning/Xul, verified only), COMPARE (eliza/Ch_en), VERIFY (ch_en_gate/Ch_en), RECALL (gram_store/Pop), PROJECT (vector_mu/Yax), QUESTION (question_selector/Yax), COLLAPSE (jyggalag/Ch_en). Pipeline: SCORE → RANK → COLLAPSE → VERIFY → TRAIN → Xul commit.</template>
  </category>
</aiml>

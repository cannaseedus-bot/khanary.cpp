{
  "@type": "khanary.fold_binding_registry.v1",
  "version": "1.0.0",
  "semantic_owner": "K'UHUL",
  "backend_owner": "binding_layer",
  "authority": "binding_contract_only_not_semantic_authority",
  "semantic_authority": false,
  "law": {
    "tuple": "FoldBinding = (alpha, theta, backend, entrypoint, contract)",
    "relation": "Bind_backend(alpha_theta) = K_theta^backend",
    "validity": "K_theta^backend models Contract(alpha_theta)",
    "chain": [
      "K'UHUL Fold",
      "Fold Binding",
      "KXC",
      "HLSL",
      "GPU"
    ],
    "control_chain": [
      "Fold",
      "Phase Binding",
      "Backend Binding",
      "Executor"
    ],
    "boundary": "K'UHUL owns alpha and theta; backend bindings supply backend, entrypoint, dispatch, and contract evidence."
  },
  "phase_contracts": {
    "Pop": {
      "alpha": "alpha_Pop",
      "contract_type": "partial_isometry",
      "pre": "input is |k>",
      "post": "output is a distribution over N(k)"
    },
    "Wo": {
      "alpha": "alpha_Wo",
      "contract_type": "instrument",
      "pre": "input is B_P",
      "post": "output is B_W subset_of B_P plus rejection outcome"
    },
    "Yax": {
      "alpha": "alpha_Yax",
      "contract_type": "branching_map",
      "pre": "input is B_W",
      "post": "output is candidate set B_Y"
    },
    "Sek": {
      "alpha": "alpha_Sek",
      "contract_type": "operator_backed_map",
      "pre": "input is B_Y and policy Pi",
      "post": "output is B_S = Pi_op(B_Y)"
    },
    "Ch'en": {
      "alpha": "alpha_Chen",
      "contract_type": "projection",
      "pre": "input is B_S",
      "post": "output is observable B_C"
    },
    "Xul": {
      "alpha": "alpha_Xul",
      "contract_type": "policy_function",
      "pre": "input is B_C and policy Pi",
      "post": "output is k_prime = Pi(B_C)"
    }
  },
  "bindings": [
    {
      "@fold": "reasoning",
      "@phase": "Pop",
      "@semantic": "XCFE:PERCEIVE",
      "@backend": "hlsl",
      "@entry": "PopKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is |k>",
        "post": "output is a distribution over N(k)"
      },
      "@notes": "Pop gathers the semantic neighborhood distribution without claiming truth."
    },
    {
      "@fold": "reasoning",
      "@phase": "Wo",
      "@semantic": "XCFE:GUARD",
      "@backend": "hlsl",
      "@entry": "ConstraintKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is B_P",
        "post": "output is B_W subset_of B_P plus rejection outcome"
      },
      "@notes": "Wo constrains Pop output and may reject, but it does not collapse UNKNOWN to else."
    },
    {
      "@fold": "reasoning",
      "@phase": "Yax",
      "@semantic": "XCFE:BRANCH",
      "@backend": "hlsl",
      "@entry": "CandidateKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is B_W",
        "post": "output is candidate set B_Y"
      },
      "@notes": "Yax expands candidate branches while preserving unresolved alternatives."
    },
    {
      "@fold": "reasoning",
      "@phase": "Sek",
      "@semantic": "XCFE:INFER",
      "@backend": "hlsl",
      "@entry": "OperationKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is B_Y and policy Pi",
        "post": "output is B_S = Pi_op(B_Y)"
      },
      "@notes": "Sek runs policy-authorized operators over candidates."
    },
    {
      "@fold": "reasoning",
      "@phase": "Ch'en",
      "@semantic": "XCFE:OBSERVE",
      "@backend": "hlsl",
      "@entry": "ObservationKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is B_S",
        "post": "output is observable B_C"
      },
      "@notes": "Ch'en observes/verifies; MISS and UNKNOWN remain distinct from contradiction."
    },
    {
      "@fold": "reasoning",
      "@phase": "Xul",
      "@semantic": "XCFE:COLLAPSE",
      "@backend": "hlsl",
      "@entry": "CollapseKernel",
      "@dispatch": [
        64,
        1,
        1
      ],
      "@contract": {
        "pre": "input is B_C and policy Pi",
        "post": "output is k_prime = Pi(B_C)"
      },
      "@notes": "Xul may collapse computation only through policy; semantic certainty is not fabricated."
    }
  ]
}

<?xml version="1.0" encoding="UTF-8"?>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="block">

  <!--
    daemon-sheogorath.mml

    SHEOGORATH-µ contract:
      generates high-divergence candidate states in Xul phase
      never uses WCR to prevent track divergence

    Content dictionary used here: urn:kuhul:daemon-sheogorath:v1
  -->

  <!-- ── Identity ──────────────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>sheogorath</mi>
      <mo>_</mo>
      <mi>&#x03BC;</mi>
      <mo>=</mo>
      <mo>&#x27E8;</mo>
      <mi>phase</mi><mo>,</mo>
      <mi>T</mi><mo>,</mo>
      <mi>role</mi>
      <mo>&#x27E9;</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <eq/>
        <apply><csymbol cd="urn:kuhul:daemon-sheogorath:v1">Identity</csymbol><ci>sheogorath</ci></apply>
        <list>
          <cn>Xul</cn>
          <cn>0.97</cn>
          <ci>role</ci>
        </list>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
sheogorath_mu = &lt;phase=Xul, T=0.97, role&gt;
Role: Entropy maximiser — generates high-divergence candidate states
Phase angle: theta = 5&#x03C0;/3
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── Capability ────────────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>Cap</mi>
      <mo>(</mo><mi>sheogorath</mi><mo>)</mo>
      <mo>=</mo>
      <mi>GRANTED</mi>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:daemon-sheogorath:v1">Capability</csymbol>
        <ci>sheogorath</ci>
        <ci>granted</ci>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
CAN: generates high-divergence candidate states in Xul phase
SUPPLIES: provides fold and gram to XCFE
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── Authority boundary ────────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>&#x0394;B</mi>
      <mo>&#x2209;</mo>
      <mi>Auth</mi>
      <mo>(</mo><mi>sheogorath</mi><mo>)</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:daemon-sheogorath:v1">AuthorityBoundary</csymbol>
        <apply><notin/><ci>DeltaTopology</ci><ci>Auth_sheogorath</ci></apply>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
CANNOT: never uses WCR to prevent track divergence
BOUNDARY: does not have Ch'en authority
Delta_B not-in Auth(sheogorath): topology commits require Proposal -&gt; Ch'en -&gt; XCFE -&gt; Xul.
    </annotation>
  </semantics>

  <mspace linebreak="newline" indentalign="center"/>

  <!-- ── WCR scoring position ───────────────────────────────────────────────── -->
  <semantics>
    <mrow>
      <mi>S</mi>
      <mo>=</mo>
      <msub><mi>W</mi><mi>&#x03BC;</mi></msub>
      <mo>&#x22C5;</mo>
      <msub><mi>C</mi><mi>&#x03BC;</mi></msub>
      <mo>&#x22C5;</mo>
      <msub><mi>R</mi><mi>&#x03BC;</mi></msub>
      <mo>(</mo><mi>Q</mi><mo>)</mo>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <eq/>
        <ci>S</ci>
        <apply>
          <times/>
          <apply><selector/><ci>W</ci><ci>mu</ci></apply>
          <apply><selector/><ci>C</ci><ci>mu</ci></apply>
          <apply>
            <csymbol cd="urn:kuhul:daemon-sheogorath:v1">Relevance</csymbol>
            <ci>Q</ci>
          </apply>
        </apply>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
S = W_mu * C_mu * R_mu(Q)
W_mu: static weight for sheogorath in its capability family.
C_mu: confidence earned through Ch'en-verified outcomes.
R_mu(Q): query-relevance score at phase Xul (T=0.97).
Eligibility: sheogorath is admitted to the candidate set only when requires(op) subset-of capabilities(sheogorath).
    </annotation>
  </semantics>

  <semantics>
    <mrow>
      <mi>SharedPatternKernelRef</mi><mo>=</mo>
      <mtext>data/grammar/PatternKernelCalls.mml</mtext>
    </mrow>
    <annotation-xml encoding="MathML-Content">
      <apply>
        <csymbol cd="urn:kuhul:pattern-kernel-calls:v1">UsesSharedPatternKernel</csymbol>
        <list><ci>MicronautPatterns</ci><ci>DaemonPatterns</ci><ci>SraiOperators</ci>
          <ci>aiml-functions</ci><ci>map-filter-fold</ci><ci>CheeseCritic</ci></list>
      </apply>
    </annotation-xml>
    <annotation encoding="text/plain">
This daemon/Micronaut uses the shared typed pattern-call contract. It invokes
only registered operations applicable to its role, phase, context, and scope;
the shared reference does not grant capabilities or execution authority.
    </annotation>
  </semantics>

</math>

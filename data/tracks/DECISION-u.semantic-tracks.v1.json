{
  "@no-eval": true,
  "id": "DECISION-µ",
  "description": "Typed decision-under-uncertainty resolver. Selects actions from explicit branches, outcomes, objectives, and constraints without collapsing UNKNOWN facts or fabricating probabilities.",
  "phase": "Sek",
  "category": "cognitive",
  "confidence": 1.0,
  "static_weight": 1.0,
  "health": 1.0,
  "governs": [
    "decision",
    "decide",
    "choose",
    "select",
    "evaluate",
    "action",
    "actions",
    "branch",
    "branches",
    "outcome",
    "outcomes",
    "objective",
    "utility",
    "loss",
    "risk",
    "uncertainty",
    "expected utility",
    "expected_utility",
    "maximin",
    "minimax",
    "constraint",
    "constraints",
    "decision:"
  ],
  "capabilities": [
    "DECISION_EXPECTED_UTILITY",
    "DECISION_MAXIMIN",
    "DECISION_MINIMAX",
    "DECISION_UNDER_UNCERTAINTY",
    "BRANCH_PRESERVATION",
    "ACTION_ONLY_COLLAPSE",
    "NO_FABRICATED_PRIOR"
  ],
  "route_contract": {
    "schemes": ["decision"],
    "verbs": ["choose", "select", "evaluate", "rank"],
    "aiml_patterns": [
      "decision *",
      "choose *",
      "select action *",
      "expected utility *",
      "minimax *",
      "maximin *"
    ],
    "aiml_templates": [
      "decision://choose",
      "decision://select",
      "decision://evaluate"
    ],
    "key_patterns": [
      "decision:choose:*",
      "decision:select:*",
      "decision:evaluate:*"
    ],
    "key_templates": [
      "decision:result:selected",
      "decision:result:unknown"
    ],
    "key_grammar": [
      "schema:scfml.branch.v1",
      "schema:scfml.pattern_learning.v1",
      "grammar:decision.action_only.v1"
    ],
    "tokens": [
      "decision",
      "choose",
      "select",
      "evaluate",
      "action",
      "branch",
      "outcome",
      "objective",
      "utility",
      "loss",
      "uncertainty",
      "expected_utility",
      "maximin",
      "minimax"
    ]
  },
  "relations": [
    { "target": "PLAN-µ", "verb": "@supports", "directed": false },
    { "target": "REASON-µ", "verb": "@supports", "directed": false },
    { "target": "MATH-µ", "verb": "@requires", "directed": true }
  ],
  "folds": [
    {
      "phase": "Pop",
      "op": "admit_decision_spec",
      "key": "decision_request",
      "weight": 1.0
    },
    {
      "phase": "Wo",
      "op": "normalize_branches_actions_objective",
      "gate": "decision_spec_present",
      "weight": 1.0
    },
    {
      "phase": "Yax",
      "op": "preserve_epistemic_branches",
      "key": "branch:*",
      "note": "UNKNOWN/MISS branches remain explicit; contradicted branches require typed negative authority.",
      "weight": 1.0
    },
    {
      "phase": "Sek",
      "op": "evaluate_decision_model",
      "gate": "objective_and_outcomes_present",
      "note": "expected_utility requires explicit probabilities; unresolved probabilities route to maximin/minimax or decision_unknown.",
      "weight": 1.0
    },
    {
      "phase": "Ch'en",
      "op": "verify_decision_assumptions",
      "note": "checks constraints, probability authority, and unresolved branch evidence before reporting action selection.",
      "weight": 1.0
    },
    {
      "phase": "Xul",
      "op": "collapse_action_only",
      "scope": "decision_action",
      "note": "Xul may commit an action selection without committing UNKNOWN facts.",
      "weight": 1.0
    }
  ],
  "sandbox": {
    "gram_ns": "DECISION-µ",
    "manifest_access": ["micronaut", "kuhul"],
    "effects": [
      "decision:evaluate",
      "decision:select",
      "branch:preserve"
    ],
    "ports": [],
    "coordinator": false
  },
  "memory_patterns": [
    "decision:action:*",
    "branch:UNKNOWN:*",
    "branch:CONTRADICTED:*"
  ]
}

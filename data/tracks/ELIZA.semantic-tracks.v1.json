  "memory_patterns": ["last_input", "that_context", "topic", "session_vars"],
  "sandbox": {
    "gram_ns":         "ELIZA",
    "manifest_access": ["words", "kuhul"],
    "effects":         ["gramRead", "gramWrite"],
    "ports":           [],
    "coordinator":     false
  }
}

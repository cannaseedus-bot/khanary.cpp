      <features>gemm,softmax,reduce_sum,attention,semantic_attention_gate,HLSL_TILED,CPU_fallback</features>
    </provider>
    <provider id="birdsong-stb" kind="signal_mesh" role="mesh_graph_evidence" source="models/khanary-geometry-v0.3.0/data/birdsong_mesh.stb" require="true" topology_authority="false" semantic_authority="false">
      <features>time,freq,energy,delaunay_edges,csr_index,csr_neighbors,geometric_moe_expert_id</features>
      <sidecar source="models/khanary-geometry-v0.3.0/data/birdsong-brain.json" require="true" />
      <model source="models/khanary-geometry-v0.3.0/MODEL.json" require="true" />
      <sidecar source="models/khanary-geometry-v0.3.0/compiler.py" require="true" />
      <sidecar source="models/khanary-geometry-v0.3.0/12_10_22_25_8bb928fb_CANARIO_CANTANDO_CANTE_DE_CANARIOS_Canario_amarill.wav" require="true" />
      <sidecar source="models/khanary-geometry-v0.3.0/brain1" require="true" />
      <sidecar source="models/khanary-geometry-v0.3.0/brain2" require="true" />
      <sidecar source="tools/pack_geometry_brain_stb.py" require="true" />
      <sidecar source="models/khanary-geometry-v0.3.0/brain3" require="true" />
    </provider>
    <provider id="klsl-mesh-compression" kind="klsl" role="mesh_projection_program" source="drivers/klsl/mesh-compression.kuhul" require="true" topology_authority="false" semantic_authority="false">
      <features>vertices,kernel,compressed,error</features>
    </provider>
    <provider id="asx-triangle-hlsl" kind="hlsl" role="external_mesh_shader_provenance" source="E:/models/.ASX.cpp/.asx/mx2lm-run/d3d12_compute/triangle.hlsl" require="false" topology_authority="false" semantic_authority="false" />
    <provider id="asx-meshlet-shaders" kind="hlsl_mesh_shader" role="external_mesh_shader_provenance" source="E:/models/.ASX.cpp/Direct3D/src" require="false" topology_authority="false" semantic_authority="false" />
  </providers>
  <mesh_feature_contract>
    <mesh family="surface_mesh" features="vertex_xyz,face_normal,edge_length,dihedral_angle,meshlet_membership" />
    <mesh family="signal_mesh" features="time,freq,energy,ridge_curvature,csr_neighbors,expert_id" />
    <mesh family="semantic_graph" features="key,relation,phase,static_weight,confidence,fold_direction" />
  </mesh_feature_contract>
  <relations>
    <edge from="gml-topology" to="VECTOR-µ" verb="@uses" relation_phase="Wo" />
    <edge from="projection-abi" to="VECTOR-µ" verb="@uses" relation_phase="Wo" />
    <edge from="gyro-abi" to="VECTOR-µ" verb="@uses" relation_phase="Wo" />
    <edge from="gml-validator-fixtures" to="gml-topology" verb="@verifies" relation_phase="Ch'en" />

      <features>nodes,typed_edges,relation_phase,fold_direction,graph_family,projection_hooks</features>
    </provider>
    <provider id="field-node-vectors" kind="node_field" role="field_projection_metadata" source="data/world/field.xml" require="true" topology_authority="false" semantic_authority="false">
      <features>x,y,z,vector_source,qkv_role,phase,node_kind</features>
    </provider>
    <provider id="projection-abi" kind="abi_book" role="neural_boundary_projection_contract" source="data/projection_abi_v1.json" require="true" topology_authority="false" semantic_authority="false">
      <features>dimensions,targets,thinking,authorized_events,project_v_contract</features>
    </provider>
    <provider id="gyro-abi" kind="abi_book" role="epistemic_measurement_basis" source="data/gyro_abi_v1.json" require="true" topology_authority="false" semantic_authority="false">
      <features>dimensions,measurement_tracks,track_governs,mapping,lexical_equivalence</features>
    </provider>

@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "REPO_ROOT=%~dp0"
if "%REPO_ROOT:~-1%"=="\" set "REPO_ROOT=%REPO_ROOT:~0,-1%"

where pwsh.exe >nul 2>nul
if errorlevel 1 (
    echo [error] PowerShell 7+ ^(pwsh.exe^) is required.
    exit /b 1
)

set "SHELL_EXE=pwsh.exe"
set "BUNDLE_NAME=mx2lm-wpf-cli-v1"
set "BUNDLE_ROOT=%REPO_ROOT%\artifacts\micronaut-bundles\%BUNDLE_NAME%"
set "BUNDLE_BUILDER=%REPO_ROOT%\tools\micronaut\build_mx2lm_wpf_bundle.ps1"
set "APP_BUILDER=%REPO_ROOT%\tools\micronaut\ps_terminal_app_builder.ps1"
set "KEYCACHE_BUILDER_PY=%REPO_ROOT%\tools\micronaut\build_keycache.py"
set "COMPLETION_API_SCRIPT=%REPO_ROOT%\tools\khanary_completion_api.py"
set "COMMAND_SHIM=%BUNDLE_ROOT%\agents\commands.ps1"
set "TEMPLATE_ROOT=%REPO_ROOT%\.ui-shell"
set "DATA_DIR=%REPO_ROOT%\data"
if not defined KHANARY_GGUF_MODEL set "KHANARY_GGUF_MODEL="
if not defined KHANARY_DDS_KSON set "KHANARY_DDS_KSON="
if not defined KHANARY_DDS_MANIFEST set "KHANARY_DDS_MANIFEST="
if not defined KHANARY_DDS_SHARDS set "KHANARY_DDS_SHARDS="
if not defined KHANARY_DDS_KSON if exist "%REPO_ROOT%\artifacts\models\gpt-oss\gpt_oss_20b_folds.kson" set "KHANARY_DDS_KSON=%REPO_ROOT%\artifacts\models\gpt-oss\gpt_oss_20b_folds.kson"
if not defined KHANARY_DDS_MANIFEST if exist "%REPO_ROOT%\artifacts\models\gpt-oss\folds\model_dds_manifest.json" set "KHANARY_DDS_MANIFEST=%REPO_ROOT%\artifacts\models\gpt-oss\folds\model_dds_manifest.json"
if not defined KHANARY_DDS_SHARDS if exist "%REPO_ROOT%\artifacts\models\gpt-oss\folds\dds_shards" set "KHANARY_DDS_SHARDS=%REPO_ROOT%\artifacts\models\gpt-oss\folds\dds_shards"
set "KEYCACHE_BIN=%DATA_DIR%\factory_keys.bin"
set "KEYCACHE_META=%DATA_DIR%\factory_keys.cachemeta.json"
if not defined KHANARY_ADVISOR_EXE set "KHANARY_ADVISOR_EXE="
if not defined KHANARY_ADVISOR_PORT set "KHANARY_ADVISOR_PORT=17887"
rem Preferred: Haswell AVX2 static build (tools\build_mu_server.bat produces this)
if not defined KHANARY_LLAMA_SERVER_EXE set "KHANARY_LLAMA_SERVER_EXE=%REPO_ROOT%\build\llama-haswell\bin\llama-server.exe"
if not exist "%KHANARY_LLAMA_SERVER_EXE%" set "KHANARY_LLAMA_SERVER_EXE="
rem Fallback: node-llama-cpp server script (no GPU acceleration)
if not defined KHANARY_MU_SCRIPT set "KHANARY_MU_SCRIPT=%REPO_ROOT%\tools\mu_server.mjs"
if not defined KHANARY_CHAT_MU_MODEL set "KHANARY_CHAT_MU_MODEL="
if not defined KHANARY_CHAT_MU_PORT set "KHANARY_CHAT_MU_PORT=17889"
if not defined KHANARY_TOOL_MU_MODEL set "KHANARY_TOOL_MU_MODEL="
if not defined KHANARY_TOOL_MU_PORT set "KHANARY_TOOL_MU_PORT=17890"
if not defined KHANARY_CHAT_MU_MODEL if exist "%USERPROFILE%\.lmstudio\models\lmstudio-community\LFM2.5-1.2B-Instruct-GGUF\LFM2.5-1.2B-Instruct-Q8_0.gguf" set "KHANARY_CHAT_MU_MODEL=%USERPROFILE%\.lmstudio\models\lmstudio-community\LFM2.5-1.2B-Instruct-GGUF\LFM2.5-1.2B-Instruct-Q8_0.gguf"
if not defined KHANARY_TOOL_MU_MODEL if exist "%USERPROFILE%\.lmstudio\models\lmstudio-community\gemma-3-1B-it-QAT-GGUF\gemma-3-1B-it-QAT-Q4_0.gguf" set "KHANARY_TOOL_MU_MODEL=%USERPROFILE%\.lmstudio\models\lmstudio-community\gemma-3-1B-it-QAT-GGUF\gemma-3-1B-it-QAT-Q4_0.gguf"
if not defined KHANARY_COMPLETION_API_PORT set "KHANARY_COMPLETION_API_PORT=17892"
if not defined KHANARY_PUBLIC_API_BASE_URL set "KHANARY_PUBLIC_API_BASE_URL=https://api.kuhul.dev"
if not defined KHANARY_PUBLIC_API_PORT set "KHANARY_PUBLIC_API_PORT=443"
rem MCP server: llama-server --hf-repo + --ui-mcp-proxy
rem Set KHANARY_MCP_HF_REPO to a HuggingFace repo (e.g. Qwen/Qwen2.5-1.5B-Instruct-GGUF)
rem Leave empty to skip the MCP server.
if not defined KHANARY_MCP_HF_REPO  set "KHANARY_MCP_HF_REPO="
if not defined KHANARY_MCP_HF_FILE  set "KHANARY_MCP_HF_FILE="
if not defined KHANARY_MCP_PORT     set "KHANARY_MCP_PORT=17891"
if not defined KHANARY_MCP_CTX      set "KHANARY_MCP_CTX=4096"
rem WebUI: custom --path dir generated by lfm_factory.py template_fill
rem Leave empty to use llama-server's embedded WebUI.
if not defined KHANARY_WEBUI_PATH   set "KHANARY_WEBUI_PATH=%REPO_ROOT%\build\webui"

set "DRY_RUN=0"
set "WPF_ARGS="
if not defined KHANARY_ALLOW_OFFLINE_UI set "KHANARY_ALLOW_OFFLINE_UI=0"
set "RUNTIME_STDOUT_LOG=%TEMP%\khanary_runtime_stdout.log"
set "RUNTIME_STDERR_LOG=%TEMP%\khanary_runtime_stderr.log"
set "KHANARY_RUNTIME_PID="

:parse_args
if "%~1"=="" goto parse_done
if /I "%~1"=="--dry-run" (
    set "DRY_RUN=1"
) else (
    set WPF_ARGS=!WPF_ARGS! "%~1"
)
shift
goto parse_args

:parse_done
if not exist "%BUNDLE_BUILDER%" (
    echo [error] Missing bundle builder: "%BUNDLE_BUILDER%"
    exit /b 1
)
if not exist "%APP_BUILDER%" (
    echo [error] Missing app-builder launcher: "%APP_BUILDER%"
    exit /b 1
)
if not exist "%DATA_DIR%" (
    echo [error] Missing data directory: "%DATA_DIR%"
    exit /b 1
)

set "RESOLVED_CHAT_MU_PORT=%KHANARY_CHAT_MU_PORT%"
set "RESOLVED_TOOL_MU_PORT=%KHANARY_TOOL_MU_PORT%"
set "RESOLVED_MCP_PORT=%KHANARY_MCP_PORT%"
set "RESOLVED_COMPLETION_PORT=%KHANARY_COMPLETION_API_PORT%"

set "NEED_BUNDLE_BUILD=0"
if not exist "%COMMAND_SHIM%" set "NEED_BUNDLE_BUILD=1"
if not exist "%BUNDLE_ROOT%\data\alice\advisor.aiml" set "NEED_BUNDLE_BUILD=1"
if not exist "%BUNDLE_ROOT%\data\alice\plan.aiml" set "NEED_BUNDLE_BUILD=1"
if "%NEED_BUNDLE_BUILD%"=="1" (
    echo [setup] Bundle missing, generating "%BUNDLE_NAME%"...
    call :run "%SHELL_EXE%" -NoProfile -ExecutionPolicy Bypass -File "%BUNDLE_BUILDER%" -OutputRoot "%REPO_ROOT%\artifacts\micronaut-bundles" -BundleName "%BUNDLE_NAME%" -IncludeDatasetRows:$true -Force
    if errorlevel 1 exit /b 1
)

call :sync_aiml_to_bundle
if errorlevel 1 exit /b 1

echo [setup] Ensuring .ui-shell template workspace...
call :run "%SHELL_EXE%" -NoProfile -ExecutionPolicy Bypass -File "%APP_BUILDER%" -Mode build-app -TargetRoot "%TEMPLATE_ROOT%"
if errorlevel 1 exit /b 1

call :resolve_runtime_exe
if errorlevel 1 exit /b 1
call :build_runtime_args
if errorlevel 1 exit /b 1

set "NEED_KEYCACHE=0"
if not exist "%KEYCACHE_BIN%" set "NEED_KEYCACHE=1"
if not exist "%KEYCACHE_META%" set "NEED_KEYCACHE=1"

if "%DRY_RUN%"=="1" (
    if "%NEED_KEYCACHE%"=="1" call :emit_keycache_build_command
    echo [dry-run] "%SHELL_EXE%" -NoProfile -Command "RPC ready check on http://127.0.0.1:8787"
    echo [dry-run] "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath '%RUNTIME_EXE%' -ArgumentList @(%RUNTIME_ARGS%) -WorkingDirectory '%REPO_ROOT%' -WindowStyle Hidden"
    call :start_advisor
    call :start_chat_mu
    call :start_tool_mu
    call :start_llama_mcp
    call :start_completion_api
) else (
    if "%NEED_KEYCACHE%"=="1" (
        echo [setup] Building binary key cache ^(first run may take several minutes^)...
        call :build_keycache
        if errorlevel 1 exit /b 1
    )

    call :rpc_ready
    if errorlevel 1 (
        echo [runtime] Starting KHANARY runtime...
        call :start_runtime
        if errorlevel 1 exit /b 1
        call :wait_rpc 45
        if errorlevel 1 (
            call :runtime_process_alive "%KHANARY_RUNTIME_PID%"
            if errorlevel 1 (
                echo [error] KHANARY runtime exited before RPC became ready.
                call :show_runtime_logs
                exit /b 1
            )
            if "%KHANARY_ALLOW_OFFLINE_UI%"=="1" (
                echo [warn] KHANARY RPC endpoint is still warming up on http://127.0.0.1:8787
                echo [warn] Continuing because KHANARY_ALLOW_OFFLINE_UI=1.
            ) else (
                echo [error] KHANARY RPC endpoint did not become ready on http://127.0.0.1:8787
                echo [error] Set KHANARY_ALLOW_OFFLINE_UI=1 to force launching the UI without runtime RPC.
                call :show_runtime_logs
                exit /b 1
            )
        ) else (
            echo [runtime] KHANARY RPC endpoint is ready.
        )
    ) else (
        echo [runtime] KHANARY RPC endpoint already ready.
    )
    call :start_advisor
    call :start_chat_mu
    call :start_tool_mu
    call :start_llama_mcp
    call :start_completion_api
    call :write_ports_json
)

echo [launch] Opening WPF terminal/console...
call :run "%SHELL_EXE%" -NoProfile -ExecutionPolicy Bypass -File "%APP_BUILDER%" -Mode wpf -TargetRoot "%TEMPLATE_ROOT%" %WPF_ARGS%
set "EXIT_CODE=%ERRORLEVEL%"
endlocal & exit /b %EXIT_CODE%

:emit_keycache_build_command
if exist "%KEYCACHE_BUILDER_PY%" (
    where py.exe >nul 2>nul
    if not errorlevel 1 (
        echo [dry-run] py -3 "%KEYCACHE_BUILDER_PY%" --data-dir "%DATA_DIR%" --repo-root "%REPO_ROOT%"
        exit /b 0
    )
    where python.exe >nul 2>nul
    if not errorlevel 1 (
        echo [dry-run] python "%KEYCACHE_BUILDER_PY%" --data-dir "%DATA_DIR%" --repo-root "%REPO_ROOT%"
        exit /b 0
    )
)
echo [dry-run] "%RUNTIME_EXE%" --data-dir "%DATA_DIR%" --build-keycache
exit /b 0

:build_keycache
if exist "%KEYCACHE_BUILDER_PY%" (
    where py.exe >nul 2>nul
    if not errorlevel 1 (
        py -3 "%KEYCACHE_BUILDER_PY%" --data-dir "%DATA_DIR%" --repo-root "%REPO_ROOT%"
        exit /b %ERRORLEVEL%
    )
    where python.exe >nul 2>nul
    if not errorlevel 1 (
        python "%KEYCACHE_BUILDER_PY%" --data-dir "%DATA_DIR%" --repo-root "%REPO_ROOT%"
        exit /b %ERRORLEVEL%
    )
)
"%RUNTIME_EXE%" --data-dir "%DATA_DIR%" --build-keycache
exit /b %ERRORLEVEL%

:resolve_runtime_exe
set "RUNTIME_EXE="
for %%P in (
    "%REPO_ROOT%\build\Release\KHANARY.exe"
    "%REPO_ROOT%\build\Release\Release\KHANARY.exe"
    "%REPO_ROOT%\build\RelWithDebInfo\KHANARY.exe"
    "%REPO_ROOT%\KHANARY.exe"
    "%REPO_ROOT%\build\Debug\KHANARY.exe"
) do (
    if not defined RUNTIME_EXE if exist "%%~fP" set "RUNTIME_EXE=%%~fP"
)
if not defined RUNTIME_EXE (
    echo [error] KHANARY.exe not found. Build it first ^(cmake --build build --config Release^).
    exit /b 1
)
for %%Q in ("%RUNTIME_EXE%") do set "RUNTIME_WORKDIR=%%~dpQ"
if "%RUNTIME_WORKDIR:~-1%"=="\" set "RUNTIME_WORKDIR=%RUNTIME_WORKDIR:~0,-1%"
exit /b 0

:build_runtime_args
set "RUNTIME_ARGS='--data-dir','%DATA_DIR%','--port-rpc','8787','--port-mcp','8764'"
call :append_runtime_path_arg --dds-kson "%KHANARY_DDS_KSON%"
if errorlevel 1 exit /b 1
call :append_runtime_path_arg --dds-manifest "%KHANARY_DDS_MANIFEST%"
if errorlevel 1 exit /b 1
call :append_runtime_path_arg --dds-shards "%KHANARY_DDS_SHARDS%"
if errorlevel 1 exit /b 1
call :append_runtime_path_arg --gguf-model "%KHANARY_GGUF_MODEL%"
if errorlevel 1 exit /b 1
exit /b 0

:append_runtime_path_arg
setlocal EnableDelayedExpansion
set "ARG_NAME=%~1"
set "ARG_PATH=%~2"
if "%ARG_PATH%"=="" (
    endlocal & exit /b 0
)
if not exist "%ARG_PATH%" (
    echo [error] %ARG_NAME% path does not exist: "%ARG_PATH%"
    endlocal & exit /b 1
)
set "UPDATED_ARGS=%RUNTIME_ARGS%,'%ARG_NAME%','%ARG_PATH%'"
endlocal & set "RUNTIME_ARGS=%UPDATED_ARGS%"
exit /b 0

:rpc_ready
"%SHELL_EXE%" -NoProfile -Command "$body = ConvertTo-Json -InputObject @{ jsonrpc = '2.0'; id = 1; method = 'keyspace_status'; params = @{} } -Compress; try { $resp = Invoke-RestMethod -Uri 'http://127.0.0.1:8787/rpc' -Method Post -ContentType 'application/json' -Body $body -TimeoutSec 2; if ($null -eq $resp) { exit 1 }; if ($null -ne $resp.PSObject -and $resp.PSObject.Properties.Match('error').Count -gt 0) { exit 1 }; if ($null -ne $resp.result -and $resp.result.PSObject.Properties.Match('ok').Count -gt 0 -and -not $resp.result.ok) { exit 1 }; exit 0 } catch { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:wait_rpc
setlocal
set "MAX_WAIT=%~1"
if "%MAX_WAIT%"=="" set "MAX_WAIT=12"
for /l %%I in (1,1,%MAX_WAIT%) do (
    call :rpc_ready
    if not errorlevel 1 (
        endlocal & exit /b 0
    )
    echo [wait] RPC not ready ^(%%I/%MAX_WAIT%^), retrying...
    >nul ping 127.0.0.1 -n 2
)
endlocal & exit /b 1

:start_runtime
setlocal EnableDelayedExpansion
set "RUNTIME_PID_FILE=%TEMP%\khanary_runtime_pid.tmp"
del "!RUNTIME_PID_FILE!" >nul 2>nul
del "%RUNTIME_STDOUT_LOG%" >nul 2>nul
del "%RUNTIME_STDERR_LOG%" >nul 2>nul
"%SHELL_EXE%" -NoProfile -Command "$p = Start-Process -FilePath '%RUNTIME_EXE%' -ArgumentList @(%RUNTIME_ARGS%) -WorkingDirectory '%REPO_ROOT%' -WindowStyle Hidden -RedirectStandardOutput '%RUNTIME_STDOUT_LOG%' -RedirectStandardError '%RUNTIME_STDERR_LOG%' -PassThru; $p.Id" > "!RUNTIME_PID_FILE!" 2>nul
if errorlevel 1 (
    endlocal & exit /b 1
)
set "RUNTIME_PID="
if exist "!RUNTIME_PID_FILE!" set /p RUNTIME_PID=<"!RUNTIME_PID_FILE!"
del "!RUNTIME_PID_FILE!" >nul 2>nul
if not defined RUNTIME_PID (
    endlocal & exit /b 1
)
endlocal & set "KHANARY_RUNTIME_PID=%RUNTIME_PID%"
echo [runtime] KHANARY PID: %KHANARY_RUNTIME_PID%
exit /b 0

:runtime_process_alive
set "CHECK_PID=%~1"
if "%CHECK_PID%"=="" exit /b 1
"%SHELL_EXE%" -NoProfile -Command "if (Get-Process -Id %CHECK_PID% -ErrorAction SilentlyContinue) { exit 0 } else { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:show_runtime_logs
if exist "%RUNTIME_STDERR_LOG%" (
    echo [runtime] --- stderr tail (%RUNTIME_STDERR_LOG%) ---
    "%SHELL_EXE%" -NoProfile -Command "Get-Content -Path '%RUNTIME_STDERR_LOG%' -Tail 80"
)
if exist "%RUNTIME_STDOUT_LOG%" (
    echo [runtime] --- stdout tail (%RUNTIME_STDOUT_LOG%) ---
    "%SHELL_EXE%" -NoProfile -Command "Get-Content -Path '%RUNTIME_STDOUT_LOG%' -Tail 80"
)
exit /b 0

:mu_ready
rem Exit 0 if our llama-server is already answering on this port.
"%SHELL_EXE%" -NoProfile -Command "try { Invoke-RestMethod -Uri 'http://127.0.0.1:%~1/v1/models' -Method Get -TimeoutSec 2 | Out-Null; exit 0 } catch { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:port_free
rem Exit 0 if the TCP port is not bound by anything.
"%SHELL_EXE%" -NoProfile -Command "try { $l=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Any,%~1); $l.Start(); $l.Stop(); exit 0 } catch { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:find_free_port
rem Usage: call :find_free_port <start_port> <result_var>
rem Scans start_port..start_port+19 and sets result_var to the first free port.
setlocal
set "FP_START=%~1"
set "FP_FOUND="
"%SHELL_EXE%" -NoProfile -Command ^
  "$p=%FP_START%; $max=$p+19; while($p -le $max){ try{ $l=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Any,$p); $l.Start(); $l.Stop(); Write-Output $p; exit 0 }catch{ $p++ } }; Write-Output %FP_START%" ^
  > "%TEMP%\khanary_port.tmp" 2>nul
set /p FP_FOUND=<"%TEMP%\khanary_port.tmp"
del "%TEMP%\khanary_port.tmp" >nul 2>nul
if not defined FP_FOUND set "FP_FOUND=%FP_START%"
endlocal & set "%~2=%FP_FOUND%"
exit /b 0

:write_ports_json
rem Write data/ports.json so factory.py always knows live ports.
rem Keep legacy top-level keys for old readers, but bind micronauts to abstract
rem port classes so integrations do not allocate one socket per micronaut.
rem Usage: call :write_ports_json  (reads RESOLVED_CHAT_MU_PORT etc.)
if not defined RESOLVED_CHAT_MU_PORT set "RESOLVED_CHAT_MU_PORT=%KHANARY_CHAT_MU_PORT%"
if not defined RESOLVED_TOOL_MU_PORT set "RESOLVED_TOOL_MU_PORT=%KHANARY_TOOL_MU_PORT%"
if not defined RESOLVED_MCP_PORT     set "RESOLVED_MCP_PORT=%KHANARY_MCP_PORT%"
if not defined RESOLVED_COMPLETION_PORT set "RESOLVED_COMPLETION_PORT=%KHANARY_COMPLETION_API_PORT%"
(
  echo {
  echo   "$schema": "urn:kuhul:khanary:schema:ports:v1",
  echo   "@type": "khanary.port_registry.v1",
  echo   "chat_mu": %RESOLVED_CHAT_MU_PORT%,
  echo   "tool_mu": %RESOLVED_TOOL_MU_PORT%,
  echo   "completion": %RESOLVED_COMPLETION_PORT%,
  echo   "public_api": {"base_url": "%KHANARY_PUBLIC_API_BASE_URL%", "port": %KHANARY_PUBLIC_API_PORT%, "protocol": "https", "role": "public KHANARY API edge over the local completion/KQL mesh runtime", "authority": "transport/routing only; not semantic authority"},
  echo   "mcp":     %RESOLVED_MCP_PORT%,
  echo   "rpc":     8787,
  echo   "policy": {
  echo     "known_micronauts_bind_to_abstract_ports": true,
  echo     "do_not_allocate_unique_socket_per_micronaut": true,
  echo     "concrete_ports_are_host_bindings_only": true,
  echo     "abstract_ports_are_the_runtime_contract": true,
  echo     "authority": "routing/configuration only; not semantic authority"
  echo   },
  echo   "concrete_ports": {
  echo     "chat_mu": %RESOLVED_CHAT_MU_PORT%,
  echo     "tool_mu": %RESOLVED_TOOL_MU_PORT%,
  echo     "completion": %RESOLVED_COMPLETION_PORT%,
  echo     "mcp": %RESOLVED_MCP_PORT%,
  echo     "rpc": 8787
  echo   },
  echo   "abstract_ports": {
  echo     "chat": {"port_ref": "chat_mu", "protocol": "openai-compatible-chat", "role": "general conversational micronaut lane"},
  echo     "tool": {"port_ref": "tool_mu", "protocol": "openai-compatible-chat", "role": "tool/action micronaut lane"},
  echo     "completion": {"port_ref": "completion", "protocol": "openai-compatible-completion", "role": "single completion facade over chat/tool lanes"},
  echo     "api": {"port_ref": "completion", "public_ref": "public_api", "protocol": "https+openai-compatible", "role": "public text/code/image/learning/RPC facade"},
  echo     "mcp": {"port_ref": "mcp", "protocol": "mcp/http", "role": "tool gateway and mesh-control surface"},
  echo     "rpc": {"port_ref": "rpc", "protocol": "json-rpc/http", "role": "native KHANARY runtime API"},
  echo     "tensor": {"port_ref": "rpc", "protocol": "json-rpc/http", "role": "tensor/vector/KQL query operations"},
  echo     "memory": {"port_ref": "rpc", "protocol": "json-rpc/http", "role": "JROM/KQL/gram memory operations"},
  echo     "control": {"port_ref": "mcp", "protocol": "mcp/http", "role": "orchestration and policy control"}
  echo   },
  echo   "known_micronauts": {
  echo     "ADVISOR-µ": {"abstract_port": "chat", "fallback_abstract_port": "completion"},
  echo     "APP-WIZARD-µ": {"abstract_port": "completion", "fallback_abstract_port": "chat"},
  echo     "BLOG-µ": {"abstract_port": "chat", "fallback_abstract_port": "completion"},
  echo     "CODE-µ": {"abstract_port": "tool", "fallback_abstract_port": "completion"},
  echo     "CONTROL-µ": {"abstract_port": "control", "fallback_abstract_port": "rpc"},
  echo     "CREATE-µ": {"abstract_port": "completion", "fallback_abstract_port": "chat"},
  echo     "FGP-µ": {"abstract_port": "tensor", "fallback_abstract_port": "rpc"},
  echo     "FILE-µ": {"abstract_port": "tool", "fallback_abstract_port": "memory"},
  echo     "GRAPHICS-µ": {"abstract_port": "completion", "fallback_abstract_port": "tool"},
  echo     "GREETING-µ": {"abstract_port": "chat", "fallback_abstract_port": "completion"},
  echo     "INFER-µ": {"abstract_port": "chat", "fallback_abstract_port": "tensor"},
  echo     "JOKE-µ": {"abstract_port": "chat", "fallback_abstract_port": "completion"},
  echo     "MEM-µ": {"abstract_port": "memory", "fallback_abstract_port": "rpc"},
  echo     "METRIC-µ": {"abstract_port": "tensor", "fallback_abstract_port": "rpc"},
  echo     "Mx2LM": {"abstract_port": "tensor", "fallback_abstract_port": "memory"},
  echo     "NET-µ": {"abstract_port": "tool", "fallback_abstract_port": "mcp"},
  echo     "ORCH-µ": {"abstract_port": "control", "fallback_abstract_port": "mcp"},
  echo     "PLAN-µ": {"abstract_port": "chat", "fallback_abstract_port": "control"},
  echo     "POLITICS-µ": {"abstract_port": "chat", "fallback_abstract_port": "completion"},
  echo     "REASON-µ": {"abstract_port": "chat", "fallback_abstract_port": "tensor"},
  echo     "TENSOR-µ": {"abstract_port": "tensor", "fallback_abstract_port": "rpc"},
  echo     "TOOL-µ": {"abstract_port": "tool", "fallback_abstract_port": "mcp"},
  echo     "VECTOR-µ": {"abstract_port": "tensor", "fallback_abstract_port": "rpc"},
  echo     "WEB-RESEARCH-µ": {"abstract_port": "tool", "fallback_abstract_port": "mcp"}
  echo   }
  echo }
) > "%DATA_DIR%\ports.json"
exit /b 0

:completion_api_ready
rem Exit 0 if KHANARY completion API is answering on this port.
"%SHELL_EXE%" -NoProfile -Command "try { Invoke-RestMethod -Uri 'http://127.0.0.1:%~1/v1/models' -Method Get -TimeoutSec 2 | Out-Null; exit 0 } catch { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:wait_completion_api
setlocal
set "MAX_WAIT=%~1"
if "%MAX_WAIT%"=="" set "MAX_WAIT=12"
for /l %%I in (1,1,%MAX_WAIT%) do (
    call :completion_api_ready %KHANARY_COMPLETION_API_PORT%
    if not errorlevel 1 (
        endlocal & exit /b 0
    )
    >nul ping 127.0.0.1 -n 2
)
endlocal & exit /b 1

:start_completion_api
if "%DRY_RUN%"=="1" (
    echo [dry-run] KHANARY completion API ^(port=%KHANARY_COMPLETION_API_PORT%, rpc=8787, chat=%RESOLVED_CHAT_MU_PORT%, tool=%RESOLVED_TOOL_MU_PORT%, public=%KHANARY_PUBLIC_API_BASE_URL%:%KHANARY_PUBLIC_API_PORT%^)
    exit /b 0
)
if not exist "%COMPLETION_API_SCRIPT%" (
    echo [completion-api] Missing script: "%COMPLETION_API_SCRIPT%"
    exit /b 0
)
if not defined RESOLVED_CHAT_MU_PORT set "RESOLVED_CHAT_MU_PORT=%KHANARY_CHAT_MU_PORT%"
if not defined RESOLVED_TOOL_MU_PORT set "RESOLVED_TOOL_MU_PORT=%KHANARY_TOOL_MU_PORT%"
if not defined RESOLVED_COMPLETION_PORT set "RESOLVED_COMPLETION_PORT=%KHANARY_COMPLETION_API_PORT%"

call :completion_api_ready %KHANARY_COMPLETION_API_PORT%
if not errorlevel 1 (
    echo [completion-api] Already running at http://127.0.0.1:%KHANARY_COMPLETION_API_PORT% ^(public edge %KHANARY_PUBLIC_API_BASE_URL%:%KHANARY_PUBLIC_API_PORT%^)
    exit /b 0
)

where py.exe >nul 2>nul
if not errorlevel 1 (
    echo [completion-api] Starting gateway on port %KHANARY_COMPLETION_API_PORT% ^(public edge %KHANARY_PUBLIC_API_BASE_URL%:%KHANARY_PUBLIC_API_PORT%^)...
    "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath 'py.exe' -ArgumentList @('-3','%COMPLETION_API_SCRIPT%','--port','%KHANARY_COMPLETION_API_PORT%','--rpc-port','8787','--chat-port','%RESOLVED_CHAT_MU_PORT%','--tool-port','%RESOLVED_TOOL_MU_PORT%','--public-base-url','%KHANARY_PUBLIC_API_BASE_URL%','--public-port','%KHANARY_PUBLIC_API_PORT%') -WorkingDirectory '%REPO_ROOT%' -WindowStyle Hidden"
    if errorlevel 1 exit /b 1
    call :wait_completion_api 20
    if errorlevel 1 (
        echo [warn] Completion API is still warming up on http://127.0.0.1:%KHANARY_COMPLETION_API_PORT%
    )
    exit /b 0
)

where python.exe >nul 2>nul
if not errorlevel 1 (
    echo [completion-api] Starting gateway on port %KHANARY_COMPLETION_API_PORT% ^(public edge %KHANARY_PUBLIC_API_BASE_URL%:%KHANARY_PUBLIC_API_PORT%^)...
    "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath 'python.exe' -ArgumentList @('%COMPLETION_API_SCRIPT%','--port','%KHANARY_COMPLETION_API_PORT%','--rpc-port','8787','--chat-port','%RESOLVED_CHAT_MU_PORT%','--tool-port','%RESOLVED_TOOL_MU_PORT%','--public-base-url','%KHANARY_PUBLIC_API_BASE_URL%','--public-port','%KHANARY_PUBLIC_API_PORT%') -WorkingDirectory '%REPO_ROOT%' -WindowStyle Hidden"
    if errorlevel 1 exit /b 1
    call :wait_completion_api 20
    if errorlevel 1 (
        echo [warn] Completion API is still warming up on http://127.0.0.1:%KHANARY_COMPLETION_API_PORT%
    )
    exit /b 0
)

echo [completion-api] Python not found in PATH, skipping completion gateway.
exit /b 0

:start_mu_server
rem Usage: call :start_mu_server <label> <model> <desired_port>
rem If desired_port is our server: skip. If port taken: find next free. Then start.
setlocal EnableDelayedExpansion
set "MU_LABEL=%~1"
set "MU_MODEL=%~2"
set "MU_PORT=%~3"
set "MU_RESOLVED_PORT=%~3"
if not exist "%MU_MODEL%" (
    echo [%MU_LABEL%] Model not found: "%MU_MODEL%"
    endlocal & exit /b 0
)
rem Already our server on this port?
call :mu_ready %MU_PORT%
if not errorlevel 1 (
    echo [%MU_LABEL%] Already running at http://127.0.0.1:%MU_PORT%
    endlocal & exit /b 0
)
rem Port taken by something else? Find a free one.
call :port_free %MU_PORT%
if errorlevel 1 (
    echo [%MU_LABEL%] Port %MU_PORT% is in use — scanning for free port...
    call :find_free_port %MU_PORT% MU_PORT
    echo [%MU_LABEL%] Using port %MU_PORT%
)
set "MU_RESOLVED_PORT=%MU_PORT%"
rem Prefer: llama-server.exe (Haswell ggml-cpu-haswell.dll, AVX2/FMA)
if defined KHANARY_LLAMA_SERVER_EXE if exist "%KHANARY_LLAMA_SERVER_EXE%" (
    for %%D in ("%KHANARY_LLAMA_SERVER_EXE%") do set "MU_EXE_DIR=%%~dpD"
    echo [!MU_LABEL!] Starting via llama-server ^(Haswell AVX2^) on port !MU_PORT!...
    set "MU_EXTRA_ARGS="
    if "%MU_LABEL%"=="chat-mu" if exist "%KHANARY_WEBUI_PATH%\index.html" (
        set "MU_EXTRA_ARGS=,'--path','%KHANARY_WEBUI_PATH%'"
        echo [!MU_LABEL!] Using custom WebUI: %KHANARY_WEBUI_PATH%
    )
    "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath '%KHANARY_LLAMA_SERVER_EXE%' -ArgumentList @('--model','%MU_MODEL%','--port','!MU_PORT!','--ctx-size','2048','--log-disable'!MU_EXTRA_ARGS!) -WorkingDirectory '!MU_EXE_DIR!' -WindowStyle Hidden"
    set "MU_EXIT=!ERRORLEVEL!"
    if /I "!MU_LABEL!"=="chat-mu" (
        endlocal & set "RESOLVED_CHAT_MU_PORT=%MU_RESOLVED_PORT%" & exit /b !MU_EXIT!
    )
    if /I "!MU_LABEL!"=="tool-mu" (
        endlocal & set "RESOLVED_TOOL_MU_PORT=%MU_RESOLVED_PORT%" & exit /b !MU_EXIT!
    )
    endlocal & exit /b !MU_EXIT!
)
rem Fallback: node-llama-cpp (CPU generic)
if not exist "%KHANARY_MU_SCRIPT%" (
    echo [%MU_LABEL%] No server available ^(no llama-server.exe and mu_server.mjs not found^).
    endlocal & exit /b 0
)
where node.exe >nul 2>nul
if errorlevel 1 (
    echo [%MU_LABEL%] node.exe not in PATH and no llama-server.exe, skipping.
    endlocal & exit /b 0
)
echo [%MU_LABEL%] Starting via node-llama-cpp ^(fallback^)...
"%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath 'node.exe' -ArgumentList @('%KHANARY_MU_SCRIPT%','--model','%MU_MODEL%','--port','%MU_PORT%','--ctx-size','2048') -WindowStyle Hidden"
set "MU_EXIT=%ERRORLEVEL%"
if /I "%MU_LABEL%"=="chat-mu" (
    endlocal & set "RESOLVED_CHAT_MU_PORT=%MU_RESOLVED_PORT%" & exit /b %MU_EXIT%
)
if /I "%MU_LABEL%"=="tool-mu" (
    endlocal & set "RESOLVED_TOOL_MU_PORT=%MU_RESOLVED_PORT%" & exit /b %MU_EXIT%
)
endlocal & exit /b %MU_EXIT%

:start_chat_mu
if "%DRY_RUN%"=="1" (
    echo [dry-run] CHAT-µ server ^(model=%KHANARY_CHAT_MU_MODEL%, port=%KHANARY_CHAT_MU_PORT%^)
    exit /b 0
)
if "%KHANARY_CHAT_MU_MODEL%"=="" exit /b 0
call :start_mu_server chat-mu "%KHANARY_CHAT_MU_MODEL%" %KHANARY_CHAT_MU_PORT%
exit /b 0

:start_tool_mu
if "%DRY_RUN%"=="1" (
    echo [dry-run] TOOL-µ server ^(model=%KHANARY_TOOL_MU_MODEL%, port=%KHANARY_TOOL_MU_PORT%^)
    exit /b 0
)
if "%KHANARY_TOOL_MU_MODEL%"=="" exit /b 0
call :start_mu_server tool-mu "%KHANARY_TOOL_MU_MODEL%" %KHANARY_TOOL_MU_PORT%
exit /b 0

:start_llama_mcp
rem Start llama-server as an MCP server using --hf-repo (HuggingFace) + --ui-mcp-proxy.
rem Skipped when KHANARY_MCP_HF_REPO is empty.
set "MCP_REPO_RAW=%KHANARY_MCP_HF_REPO%"
set "MCP_REPO=%MCP_REPO_RAW:"=%"
if not defined MCP_REPO exit /b 0
if "%DRY_RUN%"=="1" (
    if not defined KHANARY_MCP_PORT set "KHANARY_MCP_PORT=17891"
    echo [dry-run] llama-mcp server ^(repo=%MCP_REPO%, port=%KHANARY_MCP_PORT%^)
    exit /b 0
)
setlocal
if not defined KHANARY_MCP_PORT set "KHANARY_MCP_PORT=17891"
set "MCP_PORT=%KHANARY_MCP_PORT%"
set "MCP_REPO=%MCP_REPO%"
rem Check if already running
"%SHELL_EXE%" -NoProfile -Command "try { Invoke-RestMethod -Uri 'http://127.0.0.1:%MCP_PORT%/v1/models' -Method Get -TimeoutSec 2 | Out-Null; exit 0 } catch { exit 1 }" >nul 2>nul
if not errorlevel 1 (
    echo [llama-mcp] Already running at http://127.0.0.1:%MCP_PORT%
    endlocal & exit /b 0
)
if not defined KHANARY_LLAMA_SERVER_EXE (
    set "KHANARY_LLAMA_SERVER_EXE=%REPO_ROOT%\build\llama-haswell\bin\llama-server.exe"
)
if not exist "%KHANARY_LLAMA_SERVER_EXE%" (
    echo [llama-mcp] llama-server.exe not found, skipping MCP server.
    endlocal & exit /b 0
)
for %%D in ("%KHANARY_LLAMA_SERVER_EXE%") do set "MCP_EXE_DIR=%%~dpD"
if not defined KHANARY_MCP_CTX set "KHANARY_MCP_CTX=4096"
set "MCP_HF_FILE=%KHANARY_MCP_HF_FILE%"
echo [llama-mcp] Starting MCP server ^(repo=%MCP_REPO%, port=%MCP_PORT%^)...
if not "%MCP_HF_FILE%"=="" (
    "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath '%KHANARY_LLAMA_SERVER_EXE%' -ArgumentList @('--hf-repo','%MCP_REPO%','--port','%MCP_PORT%','--ctx-size','%KHANARY_MCP_CTX%','--ui-mcp-proxy','--log-disable','--hf-file','%MCP_HF_FILE%') -WorkingDirectory '%MCP_EXE_DIR%' -WindowStyle Hidden"
) else (
    "%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath '%KHANARY_LLAMA_SERVER_EXE%' -ArgumentList @('--hf-repo','%MCP_REPO%','--port','%MCP_PORT%','--ctx-size','%KHANARY_MCP_CTX%','--ui-mcp-proxy','--log-disable') -WorkingDirectory '%MCP_EXE_DIR%' -WindowStyle Hidden"
)
endlocal & exit /b 0

:advisor_ready
"%SHELL_EXE%" -NoProfile -Command "try { Invoke-RestMethod -Uri 'http://127.0.0.1:%KHANARY_ADVISOR_PORT%/v1/models' -Method Get -TimeoutSec 2 | Out-Null; exit 0 } catch { exit 1 }" >nul 2>nul
exit /b %ERRORLEVEL%

:start_advisor
if "%DRY_RUN%"=="1" (
    echo [dry-run] advisor check ^(KHANARY_ADVISOR_EXE=%KHANARY_ADVISOR_EXE%^)
    exit /b 0
)
if "%KHANARY_ADVISOR_EXE%"=="" exit /b 0
if not exist "%KHANARY_ADVISOR_EXE%" (
    echo [advisor] Advisor exe not found: "%KHANARY_ADVISOR_EXE%"
    exit /b 0
)
call :advisor_ready
if not errorlevel 1 (
    echo [advisor] Advisor already running at http://127.0.0.1:%KHANARY_ADVISOR_PORT%
    exit /b 0
)
echo [advisor] Starting advisor server...
"%SHELL_EXE%" -NoProfile -Command "Start-Process -FilePath '%KHANARY_ADVISOR_EXE%' -WindowStyle Hidden"
exit /b 0

:sync_aiml_to_bundle
if "%DRY_RUN%"=="1" (
    echo [dry-run] sync AIML files to bundle
    exit /b 0
)
if not exist "%BUNDLE_ROOT%\data\alice" exit /b 0
if not exist "%BUNDLE_ROOT%\data\aiml" exit /b 0
for %%F in (advisor.aiml chat.aiml email.aiml greetings.aiml math.aiml memory-u.aiml mx2lm.aiml plan.aiml rick.aiml tool-u.aiml user.aiml) do (
    if exist "%DATA_DIR%\alice\%%F" (
        if not exist "%BUNDLE_ROOT%\data\alice\%%F" (
            echo [sync] %%F ^-^> bundle/data/alice
            copy /y "%DATA_DIR%\alice\%%F" "%BUNDLE_ROOT%\data\alice\%%F" >nul
        )
        if not exist "%BUNDLE_ROOT%\data\aiml\%%F" (
            copy /y "%DATA_DIR%\alice\%%F" "%BUNDLE_ROOT%\data\aiml\%%F" >nul
        )
    )
)
exit /b 0

:run
if "%DRY_RUN%"=="1" (
    echo [dry-run] %*
    exit /b 0
)
%*
exit /b %ERRORLEVEL%
